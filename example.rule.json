{
  "rules": [
    {
      "name": "mock-inline-body",
      "enabled": false,
      "match": {
        "method": ["GET", "HEAD"],
        "url": "https://api.example.com/users/*"
      },
      "action": {
        "type": "mock",
        "status": 200,
        "statusMessage": "OK",
        "headers": { "X-Mock-Source": "detour" },
        "body": { "id": 1, "name": "Detour Mock User" },
        "delayMs": 200
      }
    },
    {
      "name": "mock-from-file",
      "enabled": false,
      "match": {
        "urlRegex": "^https://api\\.example\\.com/products/\\d+$",
        "urlRegexFlags": "i"
      },
      "action": {
        "type": "mock",
        "status": 200,
        "bodyFile": "example.mock-body.json"
      }
    },
    {
      "name": "mock-simulate-timeout",
      "enabled": false,
      "match": {
        "url": "https://api.example.com/slow-endpoint"
      },
      "action": {
        "type": "mock",
        "simulate": "timeout"
      }
    },
    {
      "name": "mock-simulate-close",
      "enabled": false,
      "match": {
        "url": "https://api.example.com/flaky-endpoint"
      },
      "action": {
        "type": "mock",
        "simulate": "close",
        "delayMs": 200
      }
    },
    {
      "name": "route-to-staging",
      "enabled": false,
      "match": {
        "url": "https://api.example.com/*"
      },
      "action": {
        "type": "route",
        "host": "staging.example.com",
        "port": 443,
        "preserveHostHeader": false
      }
    },
    {
      "name": "rewrite-request-and-response",
      "enabled": false,
      "match": {
        "method": "POST",
        "url": "https://api.example.com/orders"
      },
      "action": {
        "type": "rewrite",
        "request": {
          "query": {
            "set": { "debug": "1" },
            "remove": ["signature"]
          },
          "headers": {
            "set": { "X-Detour": "1" },
            "remove": ["Authorization"]
          },
          "body": {
            "set": { "forcedField": "overridden-by-detour" }
          }
        },
        "response": {
          "status": 201,
          "headers": {
            "set": { "X-Detour-Rewritten": "1" },
            "remove": ["Cache-Control"]
          },
          "body": {
            "replace": [
              { "find": "\"status\":\"pending\"", "replacement": "\"status\":\"confirmed\"" },
              { "find": "internal-[0-9]+", "replacement": "REDACTED", "regex": true, "flags": "g" }
            ],
            "merge": {
              "flags": { "newCheckout": true },
              "internalNotes": null
            }
          }
        }
      }
    },
    {
      "name": "breakpoint-checkout",
      "enabled": false,
      "match": {
        "method": "POST",
        "url": "https://api.example.com/checkout"
      },
      "action": {
        "type": "breakpoint",
        "request": true,
        "response": true
      }
    },
    {
      "name": "script-transform-orders",
      "enabled": false,
      "match": {
        "url": "https://api.example.com/orders*"
      },
      "action": {
        "type": "script",
        "path": "example.script.js"
      }
    }
  ]
}
