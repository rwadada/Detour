{
  "name": "detour",
  "version": "2.2.0",
  "description": "A terminal-first, lightweight HTTP debugging proxy for mobile and web, with a real-time web dashboard.",
  "homepage": "https://detour.rwadada.com/",
  "license": "Apache-2.0",
  "type": "commonjs",
  "bin": {
    "detour": "./bin/detour.js"
  },
  "files": [
    "bin",
    "dist",
    "web-dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build --workspace web",
    "build:cli": "tsc -p tsconfig.json",
    "build:release": "node scripts/build-release.mjs",
    "dev": "tsx watch src/cli.ts",
    "dev:dashboard": "npm run dev --workspace web",
    "start": "node bin/detour.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.protocol-parity.json && npm run typecheck --workspace web",
    "lint": "eslint .",
    "format": "biome format --write .",
    "format:check": "biome check .",
    "test": "vitest run",
    "test:web": "npm run test --workspace web",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "bench": "npm run build:cli && node scripts/bench.mjs",
    "dep-cruise": "depcruise --config .dependency-cruiser.cjs --output-type err src bin && cd web && depcruise --config ../.dependency-cruiser.cjs --ts-config tsconfig.app.json --output-type err src",
    "lint:fsd": "npm run lint:fsd --workspace web",
    "dup-check": "jscpd",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run lint:fsd && npm run dep-cruise && npm run dup-check && npm run test:coverage && npm run test:web && npm run test:e2e",
    "test:mutation": "stryker run",
    "knip": "knip"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "commander": "^15.0.0",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "node-forge": "^1.4.0",
    "protobufjs": "^8.8.0",
    "qrcode-terminal": "^0.12.0",
    "socks-proxy-agent": "^10.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "dependency-cruiser": "^18.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "execa": "^10.0.1",
    "globals": "^17.13.0",
    "jscpd": "^5.4.0",
    "knip": "^6.39.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
